# Copy to server/.env. Never use VITE_ prefixes for credentials.
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
APP_ORIGIN=http://localhost:3001

# Coordinate this UUID with Member B's stable seed before live integration.
DEMO_ACTOR_ID=00000000-0000-4000-8000-000000000001
DEMO_ACTOR_NAME="Maya Chen"
# Required: generate locally with node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
DEMO_ACCESS_CODE=

# Server-only provider configuration. F3 only calls Gemini through the smoke CLI.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
NESSIE_API_KEY=
NESSIE_BASE_URL=http://api.nessieisreal.com
DATABASE_URL=

# Deployment: set NODE_ENV=production, APP_ORIGIN to the exact public HTTPS
# origin, and HOST to the interface required by the reverse proxy/container.

# Copy to server/.env. Never use VITE_ prefixes for credentials.
# Everything here stays server-side. Never commit server/.env.

# ── API server (F3) ──────────────────────────────────────────────────
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
APP_ORIGIN=http://localhost:3001

# Demo logins (B8): npm run db:seed gives maya@split.test, sam@split.test,
# priya@split.test and alex@split.test this password (at least 8 characters).
# Anyone else signs up in the app with their own email and password.
DEMO_PASSWORD=

# ── Gemini (F3 smoke CLI, C1) ────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Voice uses the server-side Gemini key above. Gemini 3.8 Flash TTS.
GEMINI_TTS_MODEL=gemini-3.8-flash-tts

# Guard transformer (optional overrides). Training writes the default local
# artifact under server/guard/.cache/deberta-xsmall-onnx. Set MODEL_ID to a
# public Hugging Face repository to download/cache its q8 ONNX model on start.
GUARD_MODEL_PATH=
GUARD_MODEL_ID=

# ── Tiger Cloud (TimescaleDB / Postgres) (F2) ────────────────────────
# Service URL from the config you download when creating the Tiger Cloud
# service, e.g. postgres://tsdbadmin:<password>@<id>.<project>.tsdb.cloud.timescale.com:<port>/tsdb?sslmode=require
DATABASE_URL=

# Each member migrates into their own schema in the shared service so
# nobody's experiments collide: split_a, split_b, split_c. Deploy uses split.
DB_SCHEMA=split_b

# TLS. Tiger Cloud requires it; set DB_SSL=false only for a local Postgres.
DB_SSL=true
# false = still encrypted, but the certificate chain is not verified. Needed
# on machines where Node rejects the chain ("self-signed certificate in chain").
DB_SSL_VERIFY=true

# ── Nessie v2 sandbox (Capital One) ──────────────────────────────────
# API host (not the docs site). Get a key at https://v2.nessieisreal.com/account
NESSIE_BASE_URL=https://v2-prod-api.nessieisreal.com
NESSIE_API_KEY=

# Nessie account ID mapped to each demo user (acct_...). Filled by
# `npm run nessie:smoke -- --provision`, or pick from the smoke-check list.
NESSIE_ACCOUNT_ID_MAYA=
NESSIE_ACCOUNT_ID_SAM=
NESSIE_ACCOUNT_ID_PRIYA=
NESSIE_ACCOUNT_ID_ALEX=

# Deployment: set NODE_ENV=production, APP_ORIGIN to the exact public HTTPS
# origin, HOST to the interface required by the reverse proxy/container, and
# DB_SCHEMA=split.

# Split AI server environment. Copy to server/.env and fill in.
# Never commit server/.env. Everything here stays server-side.

# ── Tiger Cloud (TimescaleDB / Postgres) ─────────────────────────────
# Service URL from the config you download when creating the Tiger Cloud
# service, e.g. postgres://tsdbadmin:<password>@<id>.<project>.tsdb.cloud.timescale.com:<port>/tsdb?sslmode=require
DATABASE_URL=

# Each member migrates into their own schema in the shared service so
# nobody's experiments collide: split_a, split_b, split_c. Deploy uses split.
DB_SCHEMA=split_b

# TLS. Tiger Cloud requires it; set DB_SSL=false only for a local Postgres.
DB_SSL=true
# Set to false only if certificate verification fails on your machine.
DB_SSL_VERIFY=true

# ── Nessie v2 sandbox (Capital One) ──────────────────────────────────
# API host (not the docs site). Get a key at https://v2.nessieisreal.com/account
NESSIE_URL=https://v2-prod-api.nessieisreal.com
NESSIE_API_KEY=

# Nessie account ID mapped to each demo user (acct_...). Filled by
# `npm run nessie:smoke -- --provision`, or pick from the smoke-check list.
NESSIE_ACCOUNT_ID_MAYA=
NESSIE_ACCOUNT_ID_SAM=
NESSIE_ACCOUNT_ID_PRIYA=
NESSIE_ACCOUNT_ID_ALEX=

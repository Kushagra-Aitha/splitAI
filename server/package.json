{
  "name": "split-ai-api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env index.js",
    "dev": "node --env-file-if-exists=.env --watch index.js",
    "test": "node --test",
    "guard:train": "python3 guard/fetch-sms.py && node guard/train.js",
    "guard:eval": "node guard/train.js --eval",
    "smoke:gemini": "node --env-file-if-exists=.env scripts/smoke-gemini.js",
    "smoke:ask": "node --env-file-if-exists=.env scripts/smoke-ask.js",
    "smoke:insight": "node --env-file-if-exists=.env scripts/smoke-insight.js",
    "db:check": "node scripts/db-check.js",
    "db:migrate": "node db/migrate.js",
    "db:seed": "node db/seed.js",
    "db:setup": "node db/migrate.js && node db/seed.js",
    "db:verify": "node scripts/db-verify-fresh.js",
    "nessie:smoke": "node scripts/nessie-smoke.js",
    "banking:read": "node scripts/banking-read.js",
    "nessie:demo-activity": "node scripts/nessie-demo-activity.js",
    "banking:sync": "node scripts/banking-sync.js",
    "banking:overview-check": "node scripts/overview-check.js",
    "banking:funds-check": "node scripts/funds-race-check.js"
  },
  "dependencies": {
    "pg": "^8.13.1"
  }
}
